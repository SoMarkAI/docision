{
  "openapi": "3.0.3",
  "info": {
    "title": "Docision Local HTTP API",
    "version": "1.0.0",
    "description": "Loopback-only. Async jobs are in memory for at most one hour / latest 32 completed jobs; process restart clears jobs. One worker, 4 pending uploads. JSON requests <=36 MiB. Exports <=16 MiB; use pagination for larger results. Completed jobs may contain per-question errors."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7860"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "sessionToken": []
    }
  ],

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Docision-Token"
      }
    },
    "schemas": {
      "Question": {
        "type": "object",
        "required": [
          "question",
          "candidates"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "candidates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 26,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "name",
          "data",
          "questions"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "byte",
            "description": "Base64 document bytes; decoded size <=25 MiB"
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          },
          "prefix_cache": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Row": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "question_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correction": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "description": "Decision, candidate probabilities and runtime metadata"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at",
          "progress"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "created_at": {
            "type": "number"
          },
          "started_at": {
            "type": "number"
          },
          "finished_at": {
            "type": "number"
          },
          "progress": {
            "type": "object",
            "properties": {
              "pages_done": {
                "type": "integer"
              },
              "pages_total": {
                "type": "integer",
                "nullable": true
              },
              "rows_done": {
                "type": "integer"
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "integer"
              },
              "errors": {
                "type": "integer"
              }
            }
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
